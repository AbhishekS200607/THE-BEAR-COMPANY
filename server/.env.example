# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Business Configuration
WHATSAPP_BUSINESS_NUMBER=919605210198
RESERVATION_EXPIRY_MINUTES=120

# Test Credentials (used by automated tests in CI/CD)
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=your-test-admin-password
TEST_MANAGER_EMAIL=manager@example.com
TEST_MANAGER_PASSWORD=your-test-manager-password
TEST_CUSTOMER_EMAIL=customer@example.com
TEST_CUSTOMER_PASSWORD=your-test-customer-password

