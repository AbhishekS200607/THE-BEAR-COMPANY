{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bear-store": {
      "root": "bear-store",
      "framework": "vite",
      "bindings": [
        { "type": "service", "service": "server", "format": "url", "env": "VITE_API_BASE_URL" }
      ]
    },
    "bear-admin": {
      "root": "bear-admin",
      "framework": "vite",
      "bindings": [
        { "type": "service", "service": "server", "format": "url", "env": "VITE_API_BASE_URL" }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/admin/(.*)", "destination": { "service": "bear-admin" } },
    { "source": "/admin", "destination": { "service": "bear-admin" } },
    { "source": "/(.*)", "destination": { "service": "bear-store" } }
  ]
}
